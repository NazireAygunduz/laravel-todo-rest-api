    {
      "name": "Tek Todo Getir",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();\r",
              "const expectedId = Number(pm.environment.get(\"todo_id\"));\r",
              "\r",
              "pm.test(\"Tek Todo getirme kodu 200 olmalı\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Cevap JSON formatında olmalı\", function () {\r",
              "    pm.response.to.be.json;\r",
              "});\r",
              "\r",
              "pm.test(\"Data alanı bir nesne olmalı\", function () {\r",
              "    pm.expect(response.data).to.be.an(\"object\");\r",
              "});\r",
              "\r",
              "pm.test(\"Doğru Todo ID dönmeli\", function () {\r",
              "    pm.expect(response.data.id).to.eql(expectedId);\r",
              "});\r",
              "\r",
              "pm.test(\"Todo başlık alanı içermeli\", function () {\r",
              "    pm.expect(response.data).to.have.property(\"title\");\r",
              "});\r",
              ""
