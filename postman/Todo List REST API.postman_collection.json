              "    pm.response.to.be.json;\r",
              "});\r",
              "//data alanı liste mi\r",
              "pm.test(\"Data alanı bir liste olmalı\",function(){\r",
              "    pm.expect(response.data).to.be.an(\"array\");\r",
              "});\r",
              "//listede en az bir todo var mı\r",
              "pm.test(\"Listede en az bir Todo bulunmalı\",function(){\r",
              "    pm.expect(response.data.length).to.be.above(0);\r",
              "});"
