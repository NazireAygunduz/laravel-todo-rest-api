    {
      "name": "Todo Güncelle",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "//laravelden dönen cevabı alır\r",
              "const response =pm.response.json(); \r",
              "//Patche gönderdiğimiz Json verisini okur\r",
              "const requestBody = JSON.parse(pm.request.body.raw);\r",
              "//enviroment içindeki todo idsini sayı olarak alır\r",
              "const expectedId =Number(pm.environment.get(\"todo_id\"));\r",
              "\r",
              "pm.test(\"Todo güncelleme kodu 200 olmalı\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Cevap JSON formatında olmalı\", function () {\r",
              "    pm.response.to.be.json;\r",
              "});\r",
              "\r",
              "pm.test(\"Data alanı bir nesne olmalı\", function () {\r",
              "    pm.expect(response.data).to.be.an(\"object\");\r",
              "});\r",
              "\r",
              "pm.test(\"Doğru Todo güncellenmeli\", function () {\r",
              "    pm.expect(response.data.id).to.eql(expectedId);\r",
              "});\r",
              "\r",
              "pm.test(\"Gönderilen alanlar doğru güncellenmeli\",function(){\r",
              "    Object.keys(requestBody).forEach(function(field){\r",
              "        pm.expect(response.data[field]).to.eql(requestBody[field]);\r",
              "    });\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
