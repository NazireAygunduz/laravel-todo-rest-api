              "});\r",
              "//gelen cevap json mı\r",
              "pm.test(\"Cevap Json formatında olmalı\", function(){\r",
              "    pm.response.to.be.json;\r",
              "});\r",
              "//oluşturulan todonun bir id değeri olmalı\r",
              "pm.test(\"Errors alanı içermeli\",function(){\r",
              "    pm.expect(response).to.have.property(\"errors\");\r",
              "});\r",
              "\r",
              "pm.test(\"is_completed validation hatası bulunmalı\", function () {\r",
              "    pm.expect(response.errors).to.have.property(\"is_completed\");\r",
              "});\r",
              "\r",
              "pm.test(\"is_completed hata listesi boş olmamalı\", function () {\r",
              "    pm.expect(response.errors.is_completed).to.be.an(\"array\").that.is.not.empty;\r",
              "});\r",
              "\r",
              ""
