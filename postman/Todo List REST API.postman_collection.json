    {
      "name": "Todo Oluştur",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "//laravelden gelen Json cevabını okur \r",
              "const response = pm.response.json(); \r",
              "//Http durum kodunu kontroo eder\r",
              "pm.test(\"Todo oluşturma kodu 201 olmalı\",function(){\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "//gelen cevap json mı\r",
              "pm.test(\"Cevap Json formatında olmalı\", function(){\r",
              "    pm.response.to.be.json;\r",
              "});\r",
              "//oluşturulan todonun bir id değeri olmalı\r",
              "pm.test(\"Oluşturulan Todo ID içermeli\",function(){\r",
              "    pm.expect(response.data).to.have.property(\"id\");\r",
              "});\r",
              "//gelen başlık gönderilen başlıkla aynı mı\r",
              "pm.test(\"Todo başlığı doğru dönmeli\",function(){\r",
              "    pm.expect(response.data.title).to.eql(\"Postman otomatik id testi\")\r",
              "});\r",
              "//oluşturulan kaydın idsini environment a kaydeder\r",
              "pm.environment.set(\"todo_id\",response.data.id);\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
